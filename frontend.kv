                        MDLabel:
                            text : "WED"
                            halign : "center"
                            
                        MDLabel : 
                            id : date3
                            text : ""
                            halign : "center"
                            pos_hint_y : 0.05
                    
                MDCard:
                    md_bg_color : 0.2, 0.8, 1, 1
