                            halign : "center"
                            
                        MDLabel : 
                            id : date2
                            text : ""
                            halign : "center"
                            pos_hint_y : 0.05
                    
                MDCard:
                    md_bg_color :0.2, 0.8, 1, 1
                    size_hint_x : None
                    id : bar3
                    width : "40dp"
                    radius : [5,5,0,0]
                    size_hint_y : 0.02
                    
                    MDGridLayout:
                        cols : 1
