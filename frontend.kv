                        MDLabel:
                            text : "FRI"
                            halign : "center"
                            
                        MDLabel : 
                            id : date5
                            text : ""
                            halign : "center"
                            pos_hint_y : 0.05
                    
                MDCard:
                    md_bg_color : 0.2, 0.8, 1, 1
                    size_hint_x : None
                    id : bar6
                    width : "40dp"
